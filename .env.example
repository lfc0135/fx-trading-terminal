# Local only. Do not commit a filled copy.
# Paper is the default. Keys are optional.

# paper keeps every fill on the simulator, even if the keys below are set.
# etoro routes orders to eToro after the risk engine accepts them.
TRADING_VENUE=paper

# demo (default) or real. Real also requires the in-app confirmation.
ETORO_TRADING_MODE=demo

# From eToro: Settings → Trading → API Key Management.
# Demo environment, Read+Write. A verified (KYC) account is required.
ETORO_API_KEY=
ETORO_USER_KEY=

# Optional override. Default is the public API origin.
# ETORO_API_BASE=https://public-api.etoro.com

# Gross exposure cap as a multiple of equity. Default 2. Hard ceiling is 2.
# Paper sizing and eToro order payloads both use min(this value, 2).
LEVERAGE_CAP=2

# Local simulator starting cash, in USD.
PAPER_STARTING_BALANCE=50000
